<?xml version="1.0" encoding="utf-8"?>
<!-- Companion to data_extraction_rules.xml for Android <12: exclude everything.
     (allowBackup=false already disables backup entirely; this documents intent.) -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
