<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- READ_CONTACTS: contacts grid is the agreed core (F1). CALL_PHONE: direct call
         from the green confirmation button only (D1). No SMS, no call log, no internet. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Android 11+ package visibility: without these declarations the app cannot
         see the TTS engine (names would never be spoken) nor tell whether
         WhatsApp/Messenger/YouTube are installed (buttons would look "not installed"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.google.android.youtube" />
        <!-- Settings lists installed launchable apps for the family setter. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/MamaTheme"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfirmCallActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PhoneActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DialpadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PinGateActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
