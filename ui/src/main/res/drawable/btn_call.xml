<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#8FA893"/><corners android:radius="20dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/call_green_pressed"/><corners android:radius="20dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/call_green"/><corners android:radius="20dp"/></shape>
    </item>
</selector>
