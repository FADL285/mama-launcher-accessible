<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/phone_history_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:id="@+id/history_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btn_history_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history_all" android:textSize="21sp" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <Button android:id="@+id/btn_history_missed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history_missed" android:textSize="21sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="10dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:clipToPadding="false" android:cacheColorHint="@android:color/transparent" android:visibility="gone" />
        <ScrollView android:id="@+id/history_state" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:id="@+id/history_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_permission" android:textSize="22sp" android:textColor="?attr/surfaceText" android:padding="8dp" android:gravity="center" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/btn_allow_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/history_allow" android:textSize="22sp" />
                <Button android:id="@+id/btn_history_not_now" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/history_not_now" android:textSize="22sp" />
                <Button android:id="@+id/btn_history_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/history_retry" android:textSize="22sp" android:visibility="gone" />
                <TextView android:id="@+id/history_permission_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_permission_help" android:textColor="?attr/surfaceText" android:textSize="20sp" android:visibility="gone" />
                <Button android:id="@+id/btn_history_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/phone_app_settings" android:textSize="22sp" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <Button android:id="@+id/btn_history_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/history_more" android:textSize="22sp" android:visibility="gone" />
</LinearLayout>
