<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <Button android:id="@+id/btn_settings_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="120dp" android:padding="8dp" android:background="@drawable/tile_bg" android:text="@string/settings_back_home" android:textSize="20sp" android:textColor="@color/back_blue" android:textAllCaps="false" />
    <TextView android:id="@+id/settings_page_title" android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:gravity="start" android:text="@string/settings_title" android:textSize="24sp" android:textStyle="bold" android:textColor="?attr/surfaceText" android:padding="8dp" />
  </LinearLayout>
  <ScrollView android:id="@+id/settings_scroll" android:paddingLeft="8dp" android:paddingRight="8dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="10dp">
      <LinearLayout android:id="@+id/settings_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_menu_hint" android:textSize="16sp" android:padding="4dp" android:textColor="@color/text_main" />
        <LinearLayout android:id="@+id/open_section_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_apps_title" android:textSize="20sp" android:textColor="@color/text_main" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_apps_hint" android:textSize="15sp" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:id="@+id/open_section_sound" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_sound_title" android:textSize="20sp" android:textColor="@color/text_main" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_sound_hint" android:textSize="15sp" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:id="@+id/open_section_accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_accessibility_title" android:textSize="20sp" android:textColor="@color/text_main" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_accessibility_hint" android:textSize="15sp" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:id="@+id/open_section_permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_permissions_title" android:textSize="20sp" android:textColor="@color/text_main" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_permissions_hint" android:textSize="15sp" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:id="@+id/open_section_protection" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_protection_title" android:textSize="20sp" android:textColor="@color/text_main" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_nav_protection_hint" android:textSize="15sp" android:textColor="@color/text_main" />
        </LinearLayout>
        <include layout="@layout/developer_footer" />
      </LinearLayout>
      <LinearLayout android:id="@+id/settings_section_sound" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tts_offline_only" android:textSize="16sp" android:padding="6dp" android:textColor="@color/text_main" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_speak_label" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_speak_hint" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Switch android:id="@+id/switch_auto_speak" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حالة محرك الصوت" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:id="@+id/tts_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tts_checking" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Button android:id="@+id/btn_tts_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/btn_back" android:textColor="#FFFFFF" android:textStyle="bold" android:text="@string/tts_test" android:textSize="17sp" android:enabled="false" />
        </LinearLayout>
        <TextView android:id="@+id/tts_engine_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/tts_engine_default" android:textSize="15sp" android:textColor="@color/text_main" android:padding="8dp" />
        <Button android:id="@+id/btn_tts_engine" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/btn_back" android:textColor="#FFFFFF" android:textStyle="bold" android:text="@string/tts_choose_engine" android:textSize="17sp" />
        <Button android:id="@+id/btn_tts_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" android:background="@drawable/btn_back" android:textColor="#FFFFFF" android:textStyle="bold" android:text="@string/tts_data" android:textSize="17sp" />
        <TextView android:id="@+id/volume_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:visibility="gone" android:text="@string/volume_zero_hint" android:textSize="15sp" android:textColor="@color/danger_text" android:padding="8dp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/settings_section_permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/perm_contacts_label" android:textSize="20sp" android:textColor="@color/text_main" />
          </LinearLayout>
          <TextView android:id="@+id/perm_contacts_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/call_green" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/perm_call_label" android:textSize="20sp" android:textColor="@color/text_main" />
          </LinearLayout>
          <TextView android:id="@+id/perm_call_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/danger_text" />
        </LinearLayout>
        <Button android:id="@+id/btn_open_app_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/btn_back" android:textColor="#FFFFFF" android:textStyle="bold" android:text="@string/open_app_settings" android:textSize="17sp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/settings_section_accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/font_size_label" android:textSize="20sp" android:textColor="@color/text_main" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/btn_font_normal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="@string/font_normal" android:textSize="18sp" android:textColor="@color/text_main" android:minHeight="52dp" />
            <TextView android:id="@+id/btn_font_large" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/btn_back" android:gravity="center" android:text="@string/font_large" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF" android:minHeight="52dp" />
            <TextView android:id="@+id/btn_font_huge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="@string/font_huge" android:textSize="18sp" android:textColor="@color/text_main" android:minHeight="52dp" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/contrast_label" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/contrast_hint" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Switch android:id="@+id/switch_contrast" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/touch_guard_label" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/touch_guard_hint" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Switch android:id="@+id/switch_touch_guard" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vibrate_label" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vibrate_hint" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Switch android:id="@+id/switch_vibrate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/settings_section_protection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pin_label" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pin_hint" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Button android:id="@+id/btn_change_pin" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/btn_back" android:textColor="#FFFFFF" android:textStyle="bold" android:text="@string/pin_change" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/tile_bg" android:padding="12dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/device_lock_label" android:textSize="20sp" android:textColor="@color/text_main" />
            <TextView android:id="@+id/device_lock_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/device_lock_hint" android:textSize="15sp" android:textColor="#5A5348" />
          </LinearLayout>
          <Switch android:id="@+id/switch_device_lock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/settings_section_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/apps_section_hint" android:textSize="15sp" android:textColor="?attr/surfaceSecondaryText" />
        <LinearLayout android:id="@+id/settings_apps_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/apps_loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/apps_loading" android:textSize="16sp" android:gravity="center" android:padding="10dp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
