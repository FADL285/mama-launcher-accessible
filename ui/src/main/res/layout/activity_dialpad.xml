<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_back_dark" android:tint="?attr/surfaceAction"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/back" android:textSize="20sp" android:textColor="?attr/surfaceAction"/>
        </LinearLayout>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/dialpad_title" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="28sp" android:textSize="28sp" android:textStyle="bold" android:textColor="?attr/surfaceText"/>
        <Space android:layout_width="76dp" android:layout_height="1dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/dial_display"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="92dp"
            android:gravity="center" android:textSize="34sp" android:textStyle="bold"
            android:textColor="?attr/surfaceText" android:padding="10dp"
            android:maxLines="1" android:scrollHorizontally="true" android:ellipsize="none"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="2sp"
            android:hint="@string/dial_empty_hint" android:textDirection="ltr"/>
        <ImageView android:id="@+id/btn_backspace"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_backspace" android:tint="?attr/surfaceSecondaryText" android:padding="8dp"
            android:contentDescription="@string/backspace"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/dial_grid" android:layoutDirection="ltr"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:tag="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="1" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="2" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="3" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:tag="4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="4" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="5" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="6" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:tag="7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="7" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="8" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="9" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:tag="*" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="*" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="0" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
            <TextView android:tag="#" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="#" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/btn_save_number"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp" android:layout_margin="4dp"
            android:orientation="horizontal" android:gravity="center" android:background="@drawable/tile_bg">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_person_add"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="@string/save_number" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/back_blue"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_call"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp" android:layout_margin="4dp"
            android:orientation="horizontal" android:gravity="center" android:background="@drawable/btn_call">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_call"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="@string/call" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
