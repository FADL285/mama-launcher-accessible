<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
  <include layout="@layout/page_header" android:theme="@style/DialHeaderTheme" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp">
          <TextView android:id="@+id/dial_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/dial_empty_hint" android:textSize="24sp" android:textColor="?attr/surfaceSecondaryText" android:gravity="center" android:textDirection="rtl" />
          <TextView android:id="@+id/dial_display" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center" android:textSize="34sp" android:textStyle="bold" android:textColor="?attr/surfaceText" android:padding="2dp" android:maxLines="1" android:scrollHorizontally="true" android:ellipsize="none" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="2sp" android:visibility="invisible" android:textDirection="ltr" />
        </FrameLayout>
        <ImageView android:id="@+id/btn_backspace" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_backspace" android:tint="?attr/surfaceSecondaryText" android:padding="8dp" android:contentDescription="@string/backspace" />
      </LinearLayout>
  <ScrollView android:id="@+id/dial_results_scroll" android:layout_width="match_parent" android:layout_height="64dp" android:fillViewport="false">
      <LinearLayout android:id="@+id/dial_matches" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  </ScrollView>
  <ScrollView android:id="@+id/dial_keys_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
      <LinearLayout android:id="@+id/dial_grid" android:layoutDirection="ltr" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <TextView android:tag="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="1" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <TextView android:tag="2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="2" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <TextView android:tag="3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="3" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <TextView android:tag="4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="4" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <TextView android:tag="5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="5" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <TextView android:tag="6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="6" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <TextView android:tag="7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="7" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <TextView android:tag="8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="8" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <TextView android:tag="9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="9" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
          <TextView android:tag="*" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="*" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
          <LinearLayout android:tag="0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="74dp" android:minHeight="74dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/zero_plus_hint">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="27sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="14sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:textColor="@color/text_main" />
          </LinearLayout>
          <TextView android:tag="#" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_margin="4dp" android:background="@drawable/tile_bg" android:gravity="center" android:text="#" android:textSize="27sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="@color/text_main" />
        </LinearLayout>
      </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
    <LinearLayout android:id="@+id/btn_save_number" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp" android:layout_margin="4dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/tile_bg">
      <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_person_add" />
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:layout_marginStart="6dp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:id="@+id/save_number_label" android:text="@string/save_number" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/back_blue" />
    </LinearLayout>
    <LinearLayout android:id="@+id/btn_call" android:layout_width="0dp" android:layout_weight="1" android:layout_height="62dp" android:layout_margin="4dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/btn_call">
      <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_call" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/call" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
