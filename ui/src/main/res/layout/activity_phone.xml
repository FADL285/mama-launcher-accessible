<?xml version="1.0" encoding="utf-8"?>
<info.fadl.mamalauncher.ui.PhoneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <include layout="@layout/page_header" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <FrameLayout android:id="@+id/phone_contacts_panel" android:layout_width="match_parent" android:layout_height="match_parent">
        <GridView
            android:id="@+id/contacts_grid"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:numColumns="auto_fit" android:columnWidth="150dp"
            android:stretchMode="columnWidth"
            android:horizontalSpacing="16dp" android:verticalSpacing="16dp"
            android:padding="8dp"/>
        <ScrollView
            android:id="@+id/setup_view"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:visibility="gone">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="12dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/contacts_setup_hint" android:textSize="20sp"
                android:textColor="?attr/surfaceText" android:gravity="center"
                android:layout_marginBottom="24dp"/>
            <Button
                android:id="@+id/btn_allow_contacts"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="110dp" android:padding="20dp"
                android:text="@string/allow_contacts" android:textSize="30sp"
                android:textColor="#FFFFFF" android:background="@drawable/btn_back"/>
            <TextView android:id="@+id/contacts_permission_help"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:padding="8dp" android:gravity="center"
                android:text="@string/contacts_permission_help" android:textSize="20sp"
                android:textColor="?attr/surfaceText" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
            <Button android:id="@+id/btn_contacts_settings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:padding="12dp" android:layout_marginTop="8dp"
                android:text="@string/phone_app_settings" android:textSize="22sp" android:visibility="gone"/>
          </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/contacts_read_error" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/contacts_read_failed" android:textColor="?attr/surfaceText" android:textSize="22sp" android:gravity="center" android:padding="16dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/btn_retry_contacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/contacts_retry" android:textSize="24sp" />
            </LinearLayout>
        </ScrollView>
        <TextView
            android:id="@+id/empty_contacts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="?attr/surfaceText" android:text="@string/no_contacts_yet" android:textSize="22sp"
            android:gravity="center" android:visibility="gone" android:padding="24dp"/>
      </FrameLayout>
      <include layout="@layout/panel_call_history" />
    </FrameLayout>

    <LinearLayout android:id="@+id/btn_dialpad"
        android:layout_width="match_parent" android:layout_height="64dp" android:layout_margin="6dp"
        android:orientation="horizontal" android:gravity="center" android:background="@drawable/btn_back">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_dialpad"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/dialpad_title" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp">
        <Button android:id="@+id/btn_tab_contacts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textSize="24sp" android:text="@string/tab_contacts" android:textColor="#FFFFFF" android:background="@drawable/btn_back" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <Button android:id="@+id/btn_tab_history" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textSize="24sp" android:text="@string/tab_history" android:background="@drawable/btn_number" />
    </LinearLayout>
</info.fadl.mamalauncher.ui.PhoneLayout>
